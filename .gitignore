# --- secrets (never commit) ---
.env
.env.*
!.env.example
*.key
secrets*
*token*
.hf_token

# --- model checkpoints: large, kept LOCAL only ---
/models/
*.safetensors
*.pt
*.bin
*.ckpt

# --- large external datasets: kept LOCAL only (re-downloadable) ---
/data/external/

# --- confidential peer-review reports: kept LOCAL only ---
/reviews/reviewer_reports/

# --- caches / build junk ---
**/__pycache__/
*.pyc
.venv/
.idea/
.pytest_cache/
~$*.docx
*.PREresults.bak.docx
.DS_Store
